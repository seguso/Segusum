<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Seg</RootNamespace>
    <AssemblyName>Segusum</AssemblyName>
    <PackageId>Segusum</PackageId>
    <Title>Segusum</Title>
    <Description>Engine .NET per giochi di avventura, con logica di mondo e interazioni indipendenti dal frontend.</Description>
    <PackageTags>adventure-game;interactive-fiction;text-adventure;game-engine</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Segusum.Analyzers/Segusum.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <Import Project="../Segusum.Package.props" />

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PackSegusumAnalyzer" BeforeTargets="GenerateNuspec" DependsOnTargets="Build">
    <ItemGroup>
      <TfmSpecificPackageFile Include="../Segusum.Analyzers/bin/$(Configuration)/netstandard2.0/Segusum.Analyzers.dll"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="db.Designer.cs" />
    <Compile Remove="walk.cs" />
    <Compile Remove="ucVerb.xaml.cs" />
    <Compile Remove="go.cs" />
    <Compile Remove="unary_action_handler.cs" />
    <Compile Remove="UnaryVerb.cs" />
    <Compile Remove="pickUp.cs" />
    <Compile Remove="containerMultiple.cs" />
    <Compile Remove="roomRepresentsContainer.cs" />
    <Compile Remove="lookAt.cs" />
    <Compile Remove="talkTo.cs" />
    <Compile Remove="CutSceneWhenTheySeeYouCarrying.cs" />
    <Compile Remove="CutSceneAndPriority.cs" />
    <Compile Remove="npcSchedule.cs" />
    <Compile Remove="npsScheduleSimple.cs" />
    <Compile Remove="UnaryActionInput.cs" />
    <Compile Remove="parHtmlServer.cs" />
    <Compile Remove="OutlinedText.cs" />
    <Compile Remove="par.cs" />
    <Page Remove="ucVerb.xaml" />
  </ItemGroup>
</Project>
