{
  "name": "segusum-dsl",
  "displayName": "Segusum DSL",
  "description": "Segusum DSL semantic tooling",
  "version": "0.1.1",
  "publisher": "seguso",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:segusum", "onCommand:segusum.findAllReferences", "onCommand:segusum.renameSymbol"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{ "id": "segusum", "aliases": ["Segusum", "seg"], "extensions": [".seg"] }],
    "configuration": { "properties": { "segusum.toolingHostPath": { "type": "string", "default": "", "description": "Path to Segusum.Tooling.Host.dll" } } },
    "commands": [{ "command": "segusum.findAllReferences", "title": "Segusum: Find All References" }, { "command": "segusum.renameSymbol", "title": "Segusum: Rename Symbol" }],
    "menus": { "editor/context": [
      { "command": "segusum.findAllReferences", "when": "editorLangId == segusum || resourceExtname == .cs", "group": "navigation@segusum" },
      { "command": "segusum.renameSymbol", "when": "editorLangId == segusum || resourceExtname == .cs", "group": "navigation@segusum" }
    ] },
    "keybindings": [{ "command": "segusum.renameSymbol", "key": "ctrl+r ctrl+r" }],
    "viewsContainers": { "panel": [{ "id": "segusum.references", "title": "Segusum", "icon": "$(references)" }] },
    "views": { "segusum.references": [{ "id": "segusum.referencesView", "name": "References" }] }
  },
  "scripts": { "compile": "tsc -p ./tsconfig.json", "test:cancellation": "npm run compile && node test/pendingRequests.test.mjs", "test:invalidation": "npm run compile && node test/invalidation.test.mjs", "test": "npm run test:cancellation && node test/invalidation.test.mjs" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/vscode": "^1.85.0", "typescript": "^5.6.0" }
}
