    <div id="clientDiagnostics" style="display:none; position:fixed; left:8px; right:8px; bottom:8px; z-index:100000; background:#210d0d; color:#ffdede; border:2px solid #e66; border-radius:6px; padding:12px; font-family:monospace; font-size:13px; white-space:pre-wrap; max-height:45vh; overflow:auto; pointer-events:auto; user-select:text; -webkit-user-select:text; -webkit-touch-callout:default;">
        <div style="font-family:sans-serif; font-weight:bold; margin-bottom:6px;">Diagnostica client — Segusum.WebClient/js/main43.js</div>
        <div id="clientDiagnosticsText"></div>
        <button id="clientDiagnosticsReload" type="button" style="margin-top:8px; background:#eeeeee; color:#111111; border:1px solid #777; padding:6px 10px;">Ricarica pagina</button>
        <button id="clientDiagnosticsCopy" type="button" style="margin-top:8px; background:#eeeeee; color:#111111; border:1px solid #777; padding:6px 10px;">Copia diagnostica</button>
    </div>
    <script>
        (function () {
            function showFallbackDiagnostic(title, details) {
                var box = document.getElementById("clientDiagnostics");
                var text = document.getElementById("clientDiagnosticsText");
                if (!box || !text) return;
                text.textContent = "Client JavaScript: Segusum.WebClient/js/main43.js\n\n" + title + "\n\n" + details +
                    "\n\nURL pagina: " + window.location.href +
                    "\nUser agent: " + navigator.userAgent;
                box.style.display = "block";
            }

            window.addEventListener("error", function (event) {
                showFallbackDiagnostic("Errore nel caricamento della pagina", JSON.stringify({
                    message: event.message,
                    source: event.filename,
                    line: event.lineno,
                    column: event.colno
                }, null, 2));
            });

            setTimeout(function () {
                var waiting = document.getElementById("waitingServer");
                if (waiting && !waiting.classList.contains("nascosto")) {
                    showFallbackDiagnostic(
                        "La pagina è ancora in attesa dopo 15 secondi",
                        "Il JavaScript non ha completato l'inizializzazione oppure una richiesta al server non ha ricevuto risposta."
                    );
                }
            }, 15000);
        })();
    </script>


