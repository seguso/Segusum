@page "/past-actions"
@rendermode InteractiveServer
@inject AdminDataService Data
<h1>PastActions problematiche</h1><p class="muted">Azioni useWith/useFor realmente presenti nei save XML.</p><div class="toolbar"><label>Game ID<input type="number" @bind="gameId" /></label><label>Username<input @bind="userName" /></label><label>User ID<input type="number" @bind="userId" /></label><label>Cerca<input @bind="search" /></label><label>Tipo<select @bind="type"><option value="">tutti</option><option>useWith</option><option>useFor</option></select></label><label>Minimo<input type="number" min="1" @bind="minimum" /></label><label><input type="checkbox" @bind="separate" /> separa explanation</label><button @onclick="Reload">Aggiorna</button></div><table><thead><tr><th>Tipo</th><th>Combinazione</th><th>Explanation</th><th>Tentativi</th><th>Utenti</th><th>Ultimo</th><th>Unhandled</th></tr></thead><tbody>@foreach(var x in rows){<tr><td>@x.Type</td><td>@x.FirstId / @x.SecondId</td><td>@(x.Explanation ?? "nessuna")</td><td>@x.Attempts</td><td>@x.Users</td><td>@x.LastAttempt.ToLocalTime()</td><td>@(x.AnyUnhandled ? "sì" : "no")</td></tr>}</tbody></table>
@code {private int? gameId,userId;private string search="",userName="",type="";private int minimum=1;private bool separate=true,onlyUnhandled=true;private List<PastSummary> rows=new();protected override Task OnInitializedAsync()=>Reload();private async Task Reload()=>rows=await Data.FindPastActionsAsync(new(gameId,search,userName,userId,type,minimum,separate,onlyUnhandled));}
