@page "/users/{Id:int}"
@rendermode InteractiveServer
@inject AdminDataService Data
<h1>Dettaglio utente</h1>@if(user==null){<p>Caricamento o utente inesistente.</p>}else{<p><b>@user.User.Name</b> (#@user.User.Id), game @user.User.GameId, ultimo accesso @user.User.LastAccess, ultimo save @user.User.LastSave</p><h2>PastActions (@user.Actions.Count)</h2><table><thead><tr><th>Data</th><th>Tipo</th><th>Dettagli</th><th>Explanation</th><th>Handler</th></tr></thead><tbody>@foreach(var x in user.Actions.OrderBy(x=>x.Time)){<tr><td>@x.Time.ToLocalTime()</td><td>@x.Type</td><td>@x.Details</td><td>@x.Explanation</td><td>@(x.HandlerCalled?.ToString() ?? "non registrato")</td></tr>}</tbody></table><h2>Cicli</h2><table><thead><tr><th>ID/nome</th><th>Esecuzioni</th><th>Ultima</th></tr></thead><tbody>@foreach(var x in user.Cycles){<tr><td>@x.Id</td><td>@x.Count</td><td>@x.LastExecution</td></tr>}</tbody></table>}
@code {[Parameter]public int Id{get;set;}private AdminUserDetails? user;protected override async Task OnParametersSetAsync()=>user=await Data.GetUserAsync(Id);}
