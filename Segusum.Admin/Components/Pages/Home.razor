@page "/"
@rendermode InteractiveServer
@inject AdminDataService Data
<h1>Combinazioni non gestite</h1>
<div class="toolbar"><label>Game ID<input type="number" @bind="gameId" /></label><label>Cerca<input @bind="search" /></label><label>Categoria<select @bind="category"><option value="">tutte</option><option>combine</option><option>useFor</option><option>specialVerb</option></select></label><label>Minimo viste<input type="number" min="1" @bind="minimum" /></label><label><input type="checkbox" @bind="showIgnored" /> mostra ignorate</label><label>Ordina<select @bind="sort"><option value="last">ultima osservazione</option><option value="count">frequenza</option></select></label><label><input type="checkbox" @bind="descending" /> decrescente</label><button @onclick="Reload">Aggiorna</button></div>
<p class="muted">@rows.Count righe</p><table><thead><tr><th>Categoria</th><th>Primo</th><th>Secondo</th><th>Viste</th><th>Ultima</th><th>Stato</th><th>Azioni</th></tr></thead><tbody>@foreach (var row in rows){<tr class="@(row.isIgnored ? "ignored" : "")"><td>@row.category</td><td>@row.firstCodeName<br /><small>@row.firstId</small></td><td>@row.secondCodeName<br /><small>@row.secondId</small></td><td>@row.seenCount</td><td>@row.lastSeenUtc.ToLocalTime()</td><td>@(row.isIgnored ? row.ignoreReason : "attiva")</td><td class="actions">@if(row.isIgnored){<button @onclick="() => Reactivate(row.id)">Riattiva</button>}else{<button @onclick='() => Ignore(row.id, "nonsense")'>Ignore: nonsense</button><button @onclick='() => Ignore(row.id, "spoiler")'>Ignore: spoiler</button>}</td></tr>}</tbody></table>
@code { private int? gameId; private string search="", category="", sort="last"; private int minimum=1; private bool showIgnored, descending=true; private List<UnhandledCombination> rows=new(); protected override Task OnInitializedAsync()=>Reload(); private async Task Reload()=>rows=await Data.FindUnhandledAsync(new(gameId,search,category,showIgnored,minimum,sort,descending)); private async Task Ignore(long id,string reason){await Data.SetIgnoredAsync(id,reason);await Reload();} private async Task Reactivate(long id){await Data.ReactivateAsync(id);await Reload();} }
