<Project>
  <!-- Versione condivisa dei package pubblici correlati. -->
  <PropertyGroup>
    <!-- Segusum netstandard packages do not need the legacy Windows SDK resolver. -->
    <_EnableDefaultWindowsPlatform Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETStandard'">false</_EnableDefaultWindowsPlatform>
    <Version>0.1.37</Version>
    <Authors>Seguso</Authors>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/seguso/Segusum</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
