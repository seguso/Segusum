<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Seg</RootNamespace>
    <AssemblyName>Segusum.Persistence</AssemblyName>
    <PackageId>Segusum.Persistence</PackageId>
    <Title>Segusum persistence</Title>
    <Description>Persistenza standard per giochi creati con Segusum.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>segusum;persistence;entity-framework-core</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Project="../Segusum.Package.props" />

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Segusum/Segusum.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
  </ItemGroup>
</Project>
