<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Segusum.AspNetCore</RootNamespace>
    <AssemblyName>Segusum.AspNetCore</AssemblyName>
    <PackageId>Segusum.AspNetCore</PackageId>
    <Title>Segusum ASP.NET Core integration</Title>
    <Description>Integrazione ASP.NET Core per giochi creati con Segusum.</Description>
    <Authors>Seguso</Authors>
    <PackageTags>segusum;aspnetcore;adventure-game;interactive-fiction;text-adventure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Project="../Segusum.Package.props" />
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
    <PackageReference Include="Segusum.Analyzers" Version="$(Version)" PrivateAssets="none" />
    <ProjectReference Include="../Segusum/Segusum.csproj" />
    <ProjectReference Include="../Segusum.Persistence/Segusum.Persistence.csproj" />
    <ProjectReference Include="../Segusum.WebClient/Segusum.WebClient.csproj" />
    <ProjectReference Include="../Segusum.Scripting.Generator/Segusum.Scripting.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <ProjectReference Include="../Segusum.Scripting.Core/Segusum.Scripting.Core.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Segusum.Scripting.Generator/bin/$(Configuration)/netstandard2.0/Segusum.Scripting.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Segusum.Scripting.Core/bin/$(Configuration)/netstandard2.0/Segusum.Scripting.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/Segusum.AspNetCore.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildTransitive/Segusum.AspNetCore.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
